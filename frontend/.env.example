# Base URL the frontend uses to reach the API. Copy to ".env" for local dev.
#
# Local dev (Vite dev server + Django runserver):
VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# In Docker this is set to "/api" at build time (see frontend/Dockerfile), so
# the SPA calls nginx, which proxies /api to the backend — no CORS, no host pinning.
