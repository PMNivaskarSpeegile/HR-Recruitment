# ─────────────────────────────────────────────────────────────
#  ENVIRONMENT CONFIG TEMPLATE  —  SAFE TO COMMIT
#  Copy this file to ".env" and fill in real values:
#     copy .env.example .env     (Windows)
#     cp .env.example .env       (macOS/Linux)
# ─────────────────────────────────────────────────────────────

# --- Django core ---
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=ats_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=ats,public

# --- CORS (which frontends may call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT token lifetimes ---
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# --- Email (JD emails, UC4) ---
# Dev default prints emails to the console. For real sending, set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@atsrecruit.in
