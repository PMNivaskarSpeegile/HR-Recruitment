# ─────────────────────────────────────────────────────────────
#  docker compose environment  —  copy to ".env" (git-ignored)
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
#  Compose reads ".env" automatically for the ${VAR} values below.
# ─────────────────────────────────────────────────────────────

# Generate a real key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Keep False unless you are actively debugging. Production hardening (HSTS,
# secure cookies, SSL redirect) switches on automatically when DEBUG=False.
DEBUG=False

# Hosts/domains allowed to serve the API. Add your cloud domain here.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (the db service uses these to create the database on first start).
DB_NAME=ats_db
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend origin(s) allowed to call the API. In compose the SPA is served at :8080.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
